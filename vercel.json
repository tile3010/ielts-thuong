{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-vercel.js",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{index.html,css/**,js/**,supabase-ca.crt}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
